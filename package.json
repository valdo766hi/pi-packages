{
  "name": "pi-packages",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Centralized Pi packages by valdo766hi",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"packages/**/*.test.ts\" \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run --workspaces",
    "benchmark:lazy-skills": "node scripts/lazy-skill-benchmark.mjs",
    "check": "npm run typecheck && npm test && npm run benchmark:lazy-skills && npm run pack:check"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@gotgenes/pi-permission-system": "39.0.2",
    "@types/node": "26.2.0",
    "typebox": "1.3.34",
    "typescript": "5.9.3"
  }
}
